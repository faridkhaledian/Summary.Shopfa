  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Core.Module.Targets\Core.Module.Targets.csproj" />
    <ProjectReference Include="..\Core.Workflows\Core.Workflows.csproj" />
  </ItemGroup>

</Project>